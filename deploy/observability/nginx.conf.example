# Replace the IPs below with the actual observability, Albumary and dev IPs.
server {
    listen OBSERVABILITY_IP:3000;
    allow 192.168.1.0/24;
    deny all;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
server {
    listen OBSERVABILITY_IP:3100;
    allow ALBUMARY_IP;
    allow DEVELOPMENT_IP;
    deny all;
    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_set_header Host $host;
        client_max_body_size 16m;
    }
}
