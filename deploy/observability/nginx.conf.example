# Replace the IPs below with the actual observability, central Grafana,
# Albumary, and development hosts.
server {
    listen OBSERVABILITY_IP:3100;
    allow MONITORING_IP;
    allow ALBUMARY_IP;
    allow DEVELOPMENT_IP;
    deny all;
    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_set_header Host $host;
        client_max_body_size 16m;
    }
}
