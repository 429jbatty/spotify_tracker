{
  "uid": "albumary-operations",
  "title": "Albumary Operations",
  "description": "Operational overview from structured Albumary logs. Select development to inspect test events. Older plain-text logs do not populate structured panels.",
  "tags": [
    "albumary",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "production,development",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "development",
            "value": "development",
            "selected": false
          }
        ]
      },
      {
        "name": "activity_filter",
        "label": "Activity text / validation run ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "text": "",
            "value": "",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 11,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Counts show structured log events in the selected time range, not live service health.** Earlier plain-text logs are excluded; development may contain simulated validation failures."
      },
      "transparent": true
    },
    {
      "id": 1,
      "title": "Syncs completed",
      "description": "Completed per-user syncs during the selected time range.",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({app=\"albumary\",environment=\"$environment\"} | json | __error__=\"\" | event=\"spotify_sync_completed\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Sync failures",
      "description": "Failed per-user sync attempts during the selected time range.",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({app=\"albumary\",environment=\"$environment\"} | json | __error__=\"\" | event=\"spotify_sync_failed\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Imports completed",
      "description": "Completed jobs may still contain partial or review candidates.",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({app=\"albumary\",environment=\"$environment\"} | json | __error__=\"\" | event=\"import_finished\" | status=\"completed\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Import failures",
      "description": "Failed import attempts; a later resume may succeed.",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 18,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({app=\"albumary\",environment=\"$environment\"} | json | __error__=\"\" | event=\"import_failed\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Import stage totals",
      "description": "Total elapsed stage time in the selected range. Matching includes grouping; stages may overlap across concurrent imports.",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "sum by (stage) (sum_over_time({app=\"albumary\",environment=\"$environment\"} | json | event=\"import_stage_completed\" | unwrap duration_ms | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Total time",
              "stage": "Stage",
              "Value #A": "Total time"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Warnings and failures",
      "description": "Structured warning and error events for the selected environment. Development validation failures are simulated.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "{app=\"albumary\",environment=\"$environment\"} | json | __error__=\"\" | level=~\"warn|warning|error|critical\" | line_format `{{.event}}{{if .stage}}  stage={{.stage}}{{end}}{{if .reason}}  reason={{.reason}}{{end}}`",
          "queryType": "range",
          "instant": false,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 7,
      "title": "Recent Spotify syncs",
      "description": "Open an event to inspect run ID, phase, counts, and duration.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "{app=\"albumary\",environment=\"$environment\"} | json | __error__=\"\" | event=~\"spotify_sync_(completed|failed)|spotify_recent_plays_page_full\" | line_format `{{.event}}{{if .user_id}}  user={{.user_id}}{{end}}{{if .tracks_fetched}}  tracks={{.tracks_fetched}}{{end}}{{if .completed_albums}}  albums={{.completed_albums}}{{end}}{{if .sync_phase}}  phase={{.sync_phase}}{{end}}`",
          "queryType": "range",
          "instant": false,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 8,
      "title": "Recent imports and outcomes",
      "description": "Candidate scope identifies resume subsets. A completed job may still have review or partial candidates.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "{app=\"albumary\",environment=\"$environment\"} | json | __error__=\"\" | event=~\"import_(finished|failed|resumed|candidate_outcomes)|spotify_catalog_fallback|spotify_import_duplicate_archive\" | line_format `{{.event}}{{if .import_session_id}}  import={{.import_session_id}}{{end}}{{if .source}}  source={{.source}}{{end}}{{if .status}}  status={{.status}}{{end}}{{if .candidate_summary_scope}}  scope={{.candidate_summary_scope}}{{end}}`",
          "queryType": "range",
          "instant": false,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 9,
      "title": "API response status",
      "description": "Request events grouped by HTTP status. Counts depend on the selected interval.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "sum by (status_code) (count_over_time({app=\"albumary\",environment=\"$environment\"} | json | event=\"http_request_completed\" | __error__=\"\" [$__interval]))",
          "queryType": "range",
          "instant": false,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Recent requests",
      "description": "Matched route templates only; raw URLs and query strings are excluded.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "{app=\"albumary\",environment=\"$environment\"} | json | __error__=\"\" | event=\"http_request_completed\" | line_format `{{.method}} {{.route}}  status={{.status_code}}  duration={{.duration_ms}}ms`",
          "queryType": "range",
          "instant": false,
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 12,
      "type": "text",
      "title": "User activity",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Observed changes, not an audit trail or a count of distinct people.** Production logs are retained for 30 days; development logs for 3 days. Profile names and album titles are historical snapshots. Filter by a validation run ID to isolate simulated activity."
      },
      "transparent": true
    },
    {
      "id": 13,
      "title": "Activity by event",
      "description": "Number of observed user actions by event type in the selected time range.",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "sum by (event) (count_over_time({app=\"albumary\",environment=\"$environment\",service=\"api\"} |= `${activity_filter}` | json | __error__=\"\" | event=~\"album_manually_added|album_removed|album_listen_added|album_listen_removed|album_rating_changed|album_rating_removed|album_note_changed|album_note_removed|album_tags_changed\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "event": "Event",
              "Value": "Observed actions",
              "Value #A": "Observed actions"
            }
          }
        }
      ]
    },
    {
      "id": 14,
      "title": "Recent user activity",
      "description": "Observed changes with profile and album snapshots, rating, tags, and validation marker. Expand a line for its raw fields. Note text is never logged.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "albumary-loki"
      },
      "gridPos": {
        "x": 10,
        "y": 34,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "albumary-loki"
          },
          "editorMode": "code",
          "expr": "{app=\"albumary\",environment=\"$environment\",service=\"api\"} |= `${activity_filter}` | json | __error__=\"\" | event=~\"album_manually_added|album_removed|album_listen_added|album_listen_removed|album_rating_changed|album_rating_removed|album_note_changed|album_note_removed|album_tags_changed\" | json added_tags=\"added_tags\", removed_tags=\"removed_tags\" | line_format `{{.event}}  profile={{.profile_slug}} ({{.user_id}})  album={{.album_artist}} - {{.album_title}}{{if .rating}}  rating={{.rating}}{{end}}{{if .change}}  change={{.change}}{{end}}{{if .listened_at}}  listened_at={{.listened_at}}{{end}}{{if .added_tags}}  added={{.added_tags}}{{end}}{{if .removed_tags}}  removed={{.removed_tags}}{{end}}{{if .validation_run_id}}  [{{.validation_run_id}}]{{end}}`",
          "queryType": "range",
          "instant": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "prettifyLogMessage": false
      }
    }
  ]
}
